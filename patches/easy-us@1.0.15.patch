diff --git a/lib/interfaces/custom-window.js b/lib/interfaces/custom-window.js
index bd52dab7b2df7a0b8d7eee51922333b2ced816b6..6e51ca4fd7267d58efd755c655c702d2c801c7f5 100644
--- a/lib/interfaces/custom-window.js
+++ b/lib/interfaces/custom-window.js
@@ -412,8 +412,14 @@ class CustomWindow {
      * @param parent 挂载的父元素
      */
     mount(parent) {
-        // 随机位置插入操作面板到页面
-        parent.children[utils_1.$.random(0, parent.children.length - 1)].after(this.wrapper);
+        // 随机位置插入操作面板到页面；ucontent 等 SPA 壳在 readystatechange 时 body 还没有子节点
+        const anchor = parent.children[utils_1.$.random(0, parent.children.length - 1)];
+        if (anchor) {
+            anchor.after(this.wrapper);
