{
	"$schema": "https://json.schemastore.org/electron-builder.json",
	"appId": "ocs.enncy.cn",
	"extraMetadata": {
		"name": "OCS Desktop",
		"author": { "name": "alan34", "email": "" },
		"description": "超星自动机：超星学习通自动学习、豆包 AI 答题与本地题库（基于 OCS Desktop 修改）。"
	},
	"productName": "超星自动机",
	"asar": false,
	"publish": [{ "provider": "github", "owner": "Alan1145145", "repo": "chaoxing-auto", "private": false, "releaseType": "release" }],
	"files": ["lib/**/*", "public/**/*", "script.js", "package.json", "vendor/doubao/runtime/doubao-gateway/**/*", "LICENSE", "NOTICE.md"],
	"copyright": "Copyright © 2021 enncy (OCS Desktop, MIT). Modified by alan34 2026.",
	"nsis": {
		"oneClick": true,
		"shortcutName": "超星自动机",
		"uninstallDisplayName": "超星自动机",
		"installerIcon": "public/favicon.ico",
		"uninstallerIcon": "public/favicon.ico"
	},
	"win": {
		"icon": "public/favicon.ico",
		"artifactName": "chaoxing-auto-${version}-setup-${arch}.${ext}",
		"target": [
			{
				"target": "nsis"
			}
		],
		"requestedExecutionLevel": "highestAvailable",
		"extraResources": [
			{
				"from": "../../bin/chrome/win-${arch}/",
				"to": "bin/chrome",
				"filter": ["**/*.zip"]
			}
		]
	},
	"mac": {
		"icon": "public/favicon.icns",
		"artifactName": "ocs-${version}-setup-${os}-${arch}.${ext}",
		"target": [
			{
				"target": "dmg"
			}
		],
		"extraResources": [
			{
				"from": "../../bin/chrome/mac-${arch}/",
				"to": "bin/chrome",
				"filter": ["**/*.zip"]
			}
		]
	},
	"linux": {
		"icon": "public/favicon.png",
		"artifactName": "ocs-${version}-setup-${os}-${arch}.${ext}",
		"target": [
			{
				"target": "AppImage"
			}
		],
		"extraResources": [
			{
				"from": "../../bin/chrome/linux-${arch}/",
				"to": "bin/chrome",
				"filter": ["**/*.zip"]
			}
		]
	}
}
